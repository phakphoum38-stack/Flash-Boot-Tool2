            for d in data:

                size = int(d["Size"]) / (1024**3)

                result.append({
                    "path": d["DeviceID"],
                    "model": d["Model"],
                    "size": f"{round(size,1)} GB"
                })

            return result

        # =========================
        # p        # =========================
        elif system == "Linux":

            out = subprocess.check_output([
                "lsblk",
                "-J",
                "-o",
                "NAME,SIZE,MODEL,TRAN"
            ])

            data = json.loads(out)

            result = []

            for d in data["blockdevices"]:

                if d.get("tran") != "usb":
                    continue

                result.append({
                    "path": f"/dev/{d['name']}",
                    "model": d.get("model", "USB"),
                    "size": d.get("size", "?")
                })

            return result

        # =========================
