{
  "name": "flash-boot-tool",
  "version": "1.0.0",
  "description": "Flash Boot Tool",
  "author": "phakphoum38-stack",

  "main": "main.js",

  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },

  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },

  "build": {
    "appId": "com.flashboot.tool",
    "productName": "Flash Boot Tool",

    "directories": {
      "output": "release"
    },

    "files": [
      "main.js",
      "preload.js",
      "frontend/**/*"
    ],

    "extraResources": [
      {
      "from": "resources/backend",
      "to": "backend"
      } 
    ],

    "asarUnpack": [
      "**/*.exe"
    ],

    "win": {
      "target": "portable",
      "icon": "icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    }
  }
}
