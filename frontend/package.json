{
  "name": "flash-boot-ui",
  "version": "1.0.0",
  "main": "electron/main.js",

  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },

  "dependencies": {
    "electron": "^28.3.3"
  },

  "devDependencies": {
    "vite": "^5.0.0",
    "electron-builder": "^24.13.3"
  },

  "build": {
    "appId": "com.flashboot.tool",
    "productName": "Flash Boot Tool",

    "directories": {
      "output": "release"
    },

    "extraResources": [
      {
        "from": "../backend/dist/backend.exe",
        "to": "backend/backend.exe"
      }
    ],

    "files": [
      "dist/**/*",
      "electron/**/*"
    ],

    "win": {
      "target": "nsis"
    }
  }
}
