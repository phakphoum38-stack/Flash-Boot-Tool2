"build": {
  "appId": "com.flashboot.tool",
  "productName": "Flash Boot Tool",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*"
  ],
  "extraResources": [
    {
      "from": "../backend/dist/",
      "to": "backend",
      "filter": ["**/*.exe"]
    }
  ],
  "win": {
    "target": "nsis",
    "requestedExecutionLevel": "requireAdministrator"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis"
    }
}
